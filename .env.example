# Copy to .env (gitignored). Never put AWS keys here — use `aws configure` / exported env vars.
CLASSIFIER_MODE=hybrid          # hybrid (keywords, then LLM if unsure) | mock | anthropic | bedrock
LLM_PROVIDER=anthropic          # anthropic | bedrock (for hybrid)
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...  # set to switch the LLM on; without it hybrid = keywords only
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
CONFIDENCE_THRESHOLD=0.7
LLM_TIMEOUT_S=3.0
STAFF_PIN=2468                  # demo PIN for staff dashboards
ADMIN_PIN=1357                  # demo PIN for /admin (separate from staff)
# Frontend (Vite): department/admin pages sign themselves in with the demo PINs so their links
# open straight onto the dashboard. Set to false to require the PIN screen (anything beyond a demo).
VITE_AUTO_SIGN_IN=true
STAFF_TOKEN_SECRET=change-me-locally
RATE_LIMIT_PER_MINUTE=10
